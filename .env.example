# Meta WhatsApp Cloud API (keep real values only in Vercel environment variables)
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-string
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-permanent-meta-system-user-token
WHATSAPP_APP_SECRET=your-meta-app-secret
# Optional: set this to the current version shown in your Meta app (for example vXX.0).
META_GRAPH_API_VERSION=

# Groq OpenAI-compatible API. Create a free developer key at console.groq.com.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant
